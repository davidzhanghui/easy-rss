VITE_RSS_PROXY=auto
# RSS 抓取代理模式:
#  auto   - 默认:浏览器直连(5s)→自建代理(10s,需配 URL)→明确报错。
#           代理超时/拒连会触发 5 分钟断路器,期间自动跳过该策略。
#           公共代理默认不走:会泄露私有订阅 URL、限流且不稳定。
#  direct - 只使用浏览器直连 (部分站点会因 CORS 失败)
#  custom - 只用自建代理,需同时设置 VITE_RSS_PROXY_URL
#  allorigins | corslol | codetabs - 实验选项:直连失败后走指定公共代理
# VITE_RSS_PROXY_URL=https://your-proxy.example.com/?url={url}
#
# 自建代理配置示例 (代理需满足的接口约定见 README「自建 RSS 代理」):
# VITE_RSS_PROXY=custom
# VITE_RSS_PROXY_URL=https://your-proxy.example.com/?token=<TOKEN>&url={url}
# 注意:改完 .env 需重启 dev server (vite 启动时读取环境变量)。

# ./rss.sh 隧道目标主机（可选，仅本地用）
# RSS_TUNNEL_HOST=your-vps-ssh-alias
